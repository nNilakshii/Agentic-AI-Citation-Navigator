# Copy this file to ".env" and fill in your real keys. NEVER commit the real .env.
# Check your setup any time with:  python backend/scripts/check_env.py

# --- LLM (you only need ONE of these) ---
# Gemini — the current dev provider: free tier, no credit card, no approval step.
# Get one at https://aistudio.google.com/apikey  (starts with "AIza")
GEMINI_API_KEY=your-gemini-key-here
# Anthropic — prepaid, no free tier. Plan to use this (or Claude via GCP Vertex)
# from Phase 2.8 on, where model quality is the thing being measured.
# https://console.anthropic.com/settings/keys  (starts with "sk-ant-")
ANTHROPIC_API_KEY=your-anthropic-key-here
# OpenAI — not needed; keep as a placeholder unless you switch to it.
# https://platform.openai.com/api-keys  (starts with "sk-")
OPENAI_API_KEY=your-openai-key-here

# --- Scholarly data (free) ---
# Semantic Scholar: optional. Works unauthenticated at ~100 req/5min (shared pool);
# a key raises that to 1 req/sec. Request one at:
# https://www.semanticscholar.org/product/api#api-key-form  (takes a few days)
SEMANTIC_SCHOLAR_API_KEY=optional-but-raises-rate-limits
# OpenAlex needs no key; add your email for the "polite pool" (faster, friendlier):
OPENALEX_EMAIL=nilakshii.nagrale@gmail.com