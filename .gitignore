node_modules/
dist/
build/
.cache/
npm-debug.log*

# Data & models (keep the repo light)
data/**/*.pdf
data/**/*.json
data/cache/embeddings/
# Third-party papers fetched by the QA scripts; never published.
data/fetch-qa/
data/raw/

# ...except the pre-computed parses and reading paths of the ten sample papers.
# These are committed on purpose: the deployed image serves every sample paper
# without a single LLM call, which is what lets a public demo survive the free
# tier with several visitors at once. ~4 MB, and regenerable with
# `python backend/scripts/qa_reading_paths.py`.
#
# Allowed by id, not by folder: anything else in the cache is something opened
# locally — the developer's own PDFs, or cited papers the reader fetched (2.11)
# — with its full text, and must never be published. Before, the folder was
# allowed and private files blocked one by one; one forgotten id published a
# paper. `scripts/prune_cache.py --check` still double-checks. These ids are
# sha256 of the files in data/samples/.
!data/cache/parsed/
!data/cache/reading_paths/
